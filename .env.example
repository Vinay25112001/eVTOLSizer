# =====================================================================
# eVTOL Sizer — environment configuration
# =====================================================================
# Copy to .env.local and fill in. NOTE: Vite inlines every VITE_* variable
# into the CLIENT BUNDLE. Nothing here is secret from a user who opens the
# bundle — the win is keeping credentials out of git history and letting them
# be rotated without a code change. Anything that must genuinely stay secret
# has to live server-side.

# ── Supabase ─────────────────────────────────────────────────────────
# The anon key is PUBLIC by design and is protected by row-level security.
# It is only as safe as the RLS policies on your tables.
# ACTION REQUIRED: verify RLS on `evtol_users` — if anonymous SELECT is
# permitted, every stored credential is world-readable regardless of hashing.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# ── Authentication mode ──────────────────────────────────────────────
# "custom"   (default) the existing evtol_users table path
# "supabase"           Supabase Auth: bcrypt server-side, credential never
#                      reaches the browser, sessions are JWTs that RLS can
#                      enforce against auth.uid()
#
# BEFORE SWITCHING TO "supabase":
#   1. Test against a STAGING project, not production.
#   2. DISABLE "Confirm email" in Auth settings, or legacy accounts cannot
#      migrate silently on first sign-in (they will be told to check email).
#   3. Existing accounts migrate automatically on first successful sign-in,
#      and only after the password is proven against the stored hash.
#   4. Keep pw_hash populated until migration is complete — it is the
#      rollback path back to "custom".
VITE_AUTH_MODE=custom

# ── EmailJS (OTP delivery) ───────────────────────────────────────────
# Previously hardcoded in src/AuthSystem.jsx. Rotate these: the old values
# are in git history and can be used to send mail through your account.
VITE_EMAILJS_SERVICE=
VITE_EMAILJS_TEMPLATE=
VITE_EMAILJS_KEY=

# ── Demo SSO ─────────────────────────────────────────────────────────
# An AUTHENTICATION BYPASS: anyone who knows this string can create an
# account. Set it EMPTY in production to disable SSO sign-up entirely.
VITE_SSO_CODE=
