# Copy this file to .env and fill in your values
# Never commit .env to git

# Groq API key — used for AI Assistant tab (get free key at console.groq.com)
VITE_GROQ_KEY=your_groq_api_key_here

# Supabase — used for auth, saved designs, community features
# Get these from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# EmailJS — used for contact/feedback forms (optional)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
