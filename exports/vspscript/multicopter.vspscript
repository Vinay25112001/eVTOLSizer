/* ============================================================
 *  Multicopter — rotor-borne throughout, no wing-borne cruise
 *  Generated by eVTOL Sizer — src/export/vspscript.js
 *
 *  Built on the geom tree of NASA's RAVEN releases: a hinge
 *  carries a nacelle, the nacelle carries the prop, and the prop
 *  carries its hub, spacer and motor. Because the hinges are real
 *  HINGE geoms, this model CONVERTS in OpenVSP — drag JointRotate
 *  on any hinge from 0 (airplane) to
 *  110 (past hover); it is written at
 *  90, helicopter mode, as RAVEN ships its own.
 *
 *  Every dimension below came from the sizing loop, not from RAVEN.
 *  Edit the PARAMETERS block and re-run to reshape the aircraft.
 * ============================================================ */

void main()
{
    // ---------------- PARAMETERS ----------------
    double fusLen   = 5.87900;   // m
    double fusDiam  = 1.65000;   // m, equivalent circular diameter
    double propDiam = 8.73900;   // m
    int    nBlade   = 3;
    double tiltDeg  = 90.0;  // 90 = helicopter, 0 = airplane

    Print( string("Building: Multicopter — rotor-borne throughout, no wing-borne cruise\n") );

    // ---------------- FUSELAGE ----------------
    // RAVEN's fuselage is a ROUNDEDRECT stack of sections, not an
    // ellipse — height over width runs 0.75 at the nose to 1.69 at
    // the cabin. Sections below are this aircraft's, scaled so the
    // maximum cross-section area equals (pi/4) fusDiam^2, which is
    // what the drag and volume terms in the sizing loop assume.
    string fus = AddGeom( "FUSELAGE", "" );
    SetGeomName( fus, "Fuselage" );
    SetParmVal( fus, "Length", "Design", fusLen );
    Update();
    // 8 sections
    while ( GetNumXSec( GetXSecSurf( fus, 0 ) ) > 2 ) { CutXSec( fus, 1 ); }
    InsertXSec( fus, 1, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 2, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 3, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 4, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 5, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 6, XS_ROUNDED_RECTANGLE );
    Update();
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 0, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_0", 0.01964 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_0", 0.01473 );
    SetParmVal( fus, "XLocPercent", "XSec_0", 0.00000 );
    SetParmVal( fus, "ZLocPercent", "XSec_0", 0.00000 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 1, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_1", 0.32732 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_1", 0.24549 );
    SetParmVal( fus, "XLocPercent", "XSec_1", 0.00714 );
    SetParmVal( fus, "ZLocPercent", "XSec_1", 0.00000 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 2, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_2", 1.06378 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_2", 1.03104 );
    SetParmVal( fus, "XLocPercent", "XSec_2", 0.10643 );
    SetParmVal( fus, "ZLocPercent", "XSec_2", 0.02227 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 3, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_3", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_3", 1.28193 );
    SetParmVal( fus, "XLocPercent", "XSec_3", 0.15783 );
    SetParmVal( fus, "ZLocPercent", "XSec_3", 0.03693 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 4, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_4", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_4", 1.90180 );
    SetParmVal( fus, "XLocPercent", "XSec_4", 0.29434 );
    SetParmVal( fus, "ZLocPercent", "XSec_4", 0.07383 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 5, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_5", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_5", 1.82847 );
    SetParmVal( fus, "XLocPercent", "XSec_5", 0.47501 );
    SetParmVal( fus, "ZLocPercent", "XSec_5", 0.06969 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 6, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_6", 0.74166 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_6", 1.12596 );
    SetParmVal( fus, "XLocPercent", "XSec_6", 0.66776 );
    SetParmVal( fus, "ZLocPercent", "XSec_6", 0.05062 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 7, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_7", 0.11883 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_7", 0.51503 );
    SetParmVal( fus, "XLocPercent", "XSec_7", 1.00000 );
    SetParmVal( fus, "ZLocPercent", "XSec_7", 0.05028 );
    Update();

    // ---------------- TAIL ----------------

    // ---------------- SPONSONS / ARMS ----------------
    // RAVEN's sponson is a constant circular STACK that sweeps its
    // tail up through 0.053 of its length.
    string spon0 = AddGeom( "STACK", fus );
    SetGeomName( spon0, "Arm 1" );
    SetParmVal( spon0, "X_Rel_Location", "XForm", 2.93950 );
    SetParmVal( spon0, "Y_Rel_Location", "XForm", -0.47784 );
    SetParmVal( spon0, "Z_Rel_Location", "XForm", 0.56100 );
    SetParmVal( spon0, "Z_Rel_Rotation", "XForm", -90.000 );
    // length 6.011 m, radius 0.328 m
    Update();
    string spon1 = AddGeom( "STACK", fus );
    SetGeomName( spon1, "Arm 2" );
    SetParmVal( spon1, "X_Rel_Location", "XForm", 4.43864 );
    SetParmVal( spon1, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( spon1, "Z_Rel_Location", "XForm", 0.56100 );
    SetParmVal( spon1, "Z_Rel_Rotation", "XForm", 0.000 );
    // length 4.989 m, radius 0.328 m
    Update();
    string spon2 = AddGeom( "STACK", fus );
    SetGeomName( spon2, "Arm 3" );
    SetParmVal( spon2, "X_Rel_Location", "XForm", 2.93950 );
    SetParmVal( spon2, "Y_Rel_Location", "XForm", 0.47784 );
    SetParmVal( spon2, "Z_Rel_Location", "XForm", 0.56100 );
    SetParmVal( spon2, "Z_Rel_Rotation", "XForm", 90.000 );
    // length 6.011 m, radius 0.328 m
    Update();
    string spon3 = AddGeom( "STACK", fus );
    SetGeomName( spon3, "Arm 4" );
    SetParmVal( spon3, "X_Rel_Location", "XForm", 1.44036 );
    SetParmVal( spon3, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( spon3, "Z_Rel_Location", "XForm", 0.56100 );
    SetParmVal( spon3, "Z_Rel_Rotation", "XForm", 180.000 );
    // length 4.989 m, radius 0.328 m
    Update();

    // ---------------- ROTOR INSTALLATIONS ----------------
    // Per RAVEN: a TILTING rotor gets Hinge -> Nacelle -> Prop, and a
    // FIXED one gets no hinge and no nacelle at all — only the stack.
    // Hub, Spacer and Motor are children of the Prop in RAVEN's tree.
    bool hingeOK = true;

    // --- Rotor 1 (fixed) ---
    string prop_r0 = AddGeom( "PROP", fus );
    SetGeomName( prop_r0, "Rotor 1" );
    SetParmVal( prop_r0, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r0, "Diameter", "Design", propDiam );
    SetParmVal( prop_r0, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r0, "X_Rel_Location", "XForm", 2.93950 );
    SetParmVal( prop_r0, "Y_Rel_Location", "XForm", -6.48838 );
    SetParmVal( prop_r0, "Z_Rel_Location", "XForm", 2.40493 );
    SetParmVal( prop_r0, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( hub_r0, "Hub" );
    SetParmVal( hub_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 1.1972 m = 0.137 D  [SRC] RAVEN
    string spacer_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( spacer_r0, "Spacer" );
    SetParmVal( spacer_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.7079 m = 0.081 D  [SRC] RAVEN
    string motor_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( motor_r0, "Motor" );
    SetParmVal( motor_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 1.0574 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.211 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Rotor 2 (fixed) ---
    string prop_r1 = AddGeom( "PROP", fus );
    SetGeomName( prop_r1, "Rotor 2" );
    SetParmVal( prop_r1, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r1, "Diameter", "Design", propDiam );
    SetParmVal( prop_r1, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r1, "X_Rel_Location", "XForm", 9.42788 );
    SetParmVal( prop_r1, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r1, "Z_Rel_Location", "XForm", 2.40493 );
    SetParmVal( prop_r1, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( hub_r1, "Hub" );
    SetParmVal( hub_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 1.1972 m = 0.137 D  [SRC] RAVEN
    string spacer_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( spacer_r1, "Spacer" );
    SetParmVal( spacer_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.7079 m = 0.081 D  [SRC] RAVEN
    string motor_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( motor_r1, "Motor" );
    SetParmVal( motor_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 1.0574 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.211 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Rotor 3 (fixed) ---
    string prop_r2 = AddGeom( "PROP", fus );
    SetGeomName( prop_r2, "Rotor 3" );
    SetParmVal( prop_r2, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r2, "Diameter", "Design", propDiam );
    SetParmVal( prop_r2, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r2, "X_Rel_Location", "XForm", 2.93950 );
    SetParmVal( prop_r2, "Y_Rel_Location", "XForm", 6.48838 );
    SetParmVal( prop_r2, "Z_Rel_Location", "XForm", 2.40493 );
    SetParmVal( prop_r2, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( hub_r2, "Hub" );
    SetParmVal( hub_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 1.1972 m = 0.137 D  [SRC] RAVEN
    string spacer_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( spacer_r2, "Spacer" );
    SetParmVal( spacer_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.7079 m = 0.081 D  [SRC] RAVEN
    string motor_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( motor_r2, "Motor" );
    SetParmVal( motor_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 1.0574 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.211 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Rotor 4 (fixed) ---
    string prop_r3 = AddGeom( "PROP", fus );
    SetGeomName( prop_r3, "Rotor 4" );
    SetParmVal( prop_r3, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r3, "Diameter", "Design", propDiam );
    SetParmVal( prop_r3, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r3, "X_Rel_Location", "XForm", -3.54888 );
    SetParmVal( prop_r3, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r3, "Z_Rel_Location", "XForm", 2.40493 );
    SetParmVal( prop_r3, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( hub_r3, "Hub" );
    SetParmVal( hub_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 1.1972 m = 0.137 D  [SRC] RAVEN
    string spacer_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( spacer_r3, "Spacer" );
    SetParmVal( spacer_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.7079 m = 0.081 D  [SRC] RAVEN
    string motor_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( motor_r3, "Motor" );
    SetParmVal( motor_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 1.0574 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.211 D above the member carrying it  [SRC] RAVEN
    Update();

    // ---------------- LANDING GEAR ----------------
    // Stations from RAVEN SWFT; every SIZE is this tool's own CS-27
    // drop-test result, so the gear changes with the aircraft.
    // nose 0.0824 fL, main 0.4431 fL,
    // track/span 0.1903, tyre 0.559 m
    string ngear = AddGeom( "STACK", fus );
    SetGeomName( ngear, "Nose Gear" );
    SetParmVal( ngear, "X_Rel_Location", "XForm", 0.48443 );
    SetParmVal( ngear, "Z_Rel_Location", "XForm", -1.01753 );
    string mgear = AddGeom( "STACK", fus );
    SetGeomName( mgear, "Main Gear" );
    SetParmVal( mgear, "X_Rel_Location", "XForm", 2.60506 );
    SetParmVal( mgear, "Y_Rel_Location", "XForm", 0.91073 );
    SetParmVal( mgear, "Z_Rel_Location", "XForm", -0.92863 );
    SetParmVal( mgear, "Sym_Planar_Flag", "Sym", SYM_XZ );
    Update();

    // ---------------- REPORT AND WRITE ----------------
    if ( !hingeOK )
    {
        Print( string("NOTE: AddGeom(\"HINGE\") returned nothing on this build.\n") );
        Print( string("      The model is complete but its rotors cannot be tilted.\n") );
        Print( string("      Add a Hinge by hand and re-parent the nacelles to it.\n") );
    }
    else
    {
        Print( string("Hinges built. Drag JointRotate 0..110 to convert.\n") );
    }
    Update();
    WriteVSPFile( "multicopter.vsp3" );
    Print( string("Wrote model.\n") );
}
