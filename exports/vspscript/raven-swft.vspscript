    SetParmVal( r_outboard_proprotor, "Z_Rel_Location", "XForm", -0.018880 );
    SetParmVal( r_outboard_proprotor, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( r_outboard_proprotor, "Y_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( r_outboard_proprotor, "Z_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( r_outboard_proprotor, "Diameter", "Design", 19.500000 );
    SetParmVal( r_outboard_proprotor, "NumBlade", "Design", 3.000000 );
    SetParmVal( r_outboard_proprotor, "Solidity", "Design", 0.169649 );
    SetParmVal( r_outboard_proprotor, "Sym_Planar_Flag", "Sym", 0.000000 );
    Update();

    // Nose Gear  [Fuselage]
    string nose_gear = AddGeom( "FUSELAGE", "" );
    SetGeomName( nose_gear, "Nose Gear" );
    SetParmVal( nose_gear, "X_Rel_Location", "XForm", 3.540000 );
    SetParmVal( nose_gear, "Y_Rel_Location", "XForm", -0.500000 );
    SetParmVal( nose_gear, "Z_Rel_Location", "XForm", -9.350000 );
    SetParmVal( nose_gear, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( nose_gear, "Y_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( nose_gear, "Z_Rel_Rotation", "XForm", 90.000000 );
    SetParmVal( nose_gear, "Length", "Design", 1.000000 );
    SetParmVal( nose_gear, "Sym_Planar_Flag", "Sym", 0.000000 );
    Update();

    // Nose Gear Caster  [Fuselage]
    string nose_gear_caster = AddGeom( "FUSELAGE", nose_gear );
    SetGeomName( nose_gear_caster, "Nose Gear Caster" );
    SetParmVal( nose_gear_caster, "X_Rel_Location", "XForm", -0.760870 );
    SetParmVal( nose_gear_caster, "Y_Rel_Location", "XForm", 0.000000 );
    SetParmVal( nose_gear_caster, "Z_Rel_Location", "XForm", 0.950000 );
    SetParmVal( nose_gear_caster, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( nose_gear_caster, "Y_Rel_Rotation", "XForm", -45.000000 );
    SetParmVal( nose_gear_caster, "Z_Rel_Rotation", "XForm", 90.000000 );
    SetParmVal( nose_gear_caster, "Length", "Design", 1.000000 );
    SetParmVal( nose_gear_caster, "Sym_Planar_Flag", "Sym", 0.000000 );
    Update();

    // Nose Gear Spar  [Fuselage]
    string nose_gear_spar = AddGeom( "FUSELAGE", nose_gear );
    SetGeomName( nose_gear_spar, "Nose Gear Spar" );
    SetParmVal( nose_gear_spar, "X_Rel_Location", "XForm", 2.222218 );
    SetParmVal( nose_gear_spar, "Y_Rel_Location", "XForm", 0.000000 );
    SetParmVal( nose_gear_spar, "Z_Rel_Location", "XForm", -8.001019 );
    SetParmVal( nose_gear_spar, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( nose_gear_spar, "Y_Rel_Rotation", "XForm", -40.250000 );
    SetParmVal( nose_gear_spar, "Z_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( nose_gear_spar, "Length", "Design", 5.500000 );
    SetParmVal( nose_gear_spar, "Sym_Planar_Flag", "Sym", 0.000000 );
    Update();

    // Main Gear  [Fuselage]
    string main_gear = AddGeom( "FUSELAGE", "" );
    SetGeomName( main_gear, "Main Gear" );
    SetParmVal( main_gear, "X_Rel_Location", "XForm", 20.440000 );
    SetParmVal( main_gear, "Y_Rel_Location", "XForm", 6.525000 );
    SetParmVal( main_gear, "Z_Rel_Location", "XForm", -9.350000 );
    SetParmVal( main_gear, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( main_gear, "Y_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( main_gear, "Z_Rel_Rotation", "XForm", 90.000000 );
    SetParmVal( main_gear, "Length", "Design", 1.000000 );
    SetParmVal( main_gear, "Sym_Planar_Flag", "Sym", 2.000000 );
    Update();

    // Main Gear Struts  [Wing]
    string main_gear_struts = AddGeom( "WING", main_gear );
    SetGeomName( main_gear_struts, "Main Gear Struts" );
    SetParmVal( main_gear_struts, "X_Rel_Location", "XForm", -2.420000 );
    SetParmVal( main_gear_struts, "Y_Rel_Location", "XForm", -6.525000 );
    SetParmVal( main_gear_struts, "Z_Rel_Location", "XForm", 4.550000 );
    SetParmVal( main_gear_struts, "X_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( main_gear_struts, "Y_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( main_gear_struts, "Z_Rel_Rotation", "XForm", 0.000000 );
    SetParmVal( main_gear_struts, "TotalSpan", "WingGeom", 17.000000 );
    SetParmVal( main_gear_struts, "TotalArea", "WingGeom", 40.000000 );
    SetParmVal( main_gear_struts, "TotalAR", "WingGeom", 4.510125 );
    SetParmVal( main_gear_struts, "Sym_Planar_Flag", "Sym", 2.000000 );
    Update();

    if ( !hingeOK )
        Print( string("NOTE: AddGeom(\"HINGE\") returned nothing; hinges are absent and the model cannot convert.\n") );
    // NOT emitted, because this converter does not handle their type:
    //   Inboard Forward ESC (Custom)
    //   Inboard Aft ESC (Custom)
    //   Outboard ESC (Custom)
    WriteVSPFile( "rebuilt.vsp3" );
    Print( string("Rebuilt 25 of 28 geoms.\n") );
}
