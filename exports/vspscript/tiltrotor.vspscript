/* ============================================================
 *  Tiltrotor / tiltwing — rotors tilt, none stop
 *  Generated by eVTOL Sizer — src/export/vspscript.js
 *
 *  Built on the geom tree of NASA's RAVEN releases: a hinge
 *  carries a nacelle, the nacelle carries the prop, and the prop
 *  carries its hub, spacer and motor. Because the hinges are real
 *  HINGE geoms, this model CONVERTS in OpenVSP — drag JointRotate
 *  on any hinge from 0 (airplane) to
 *  110 (past hover); it is written at
 *  90, helicopter mode, as RAVEN ships its own.
 *
 *  Every dimension below came from the sizing loop, not from RAVEN.
 *  Edit the PARAMETERS block and re-run to reshape the aircraft.
 * ============================================================ */

void main()
{
    // ---------------- PARAMETERS ----------------
    double fusLen   = 7.31100;   // m
    double fusDiam  = 1.65000;   // m, equivalent circular diameter
    double propDiam = 3.14000;   // m
    int    nBlade   = 3;
    double tiltDeg  = 90.0;  // 90 = helicopter, 0 = airplane
    double wingSpan = 13.46000;   // m
    double wingArea = 20.12000;   // m^2
    double wingSweep= 9.570;   // deg

    Print( string("Building: Tiltrotor / tiltwing — rotors tilt, none stop\n") );

    // ---------------- FUSELAGE ----------------
    // RAVEN's fuselage is a ROUNDEDRECT stack of sections, not an
    // ellipse — height over width runs 0.75 at the nose to 1.69 at
    // the cabin. Sections below are this aircraft's, scaled so the
    // maximum cross-section area equals (pi/4) fusDiam^2, which is
    // what the drag and volume terms in the sizing loop assume.
    string fus = AddGeom( "FUSELAGE", "" );
    SetGeomName( fus, "Fuselage" );
    SetParmVal( fus, "Length", "Design", fusLen );
    Update();
    // 8 sections
    while ( GetNumXSec( GetXSecSurf( fus, 0 ) ) > 2 ) { CutXSec( fus, 1 ); }
    InsertXSec( fus, 1, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 2, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 3, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 4, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 5, XS_ROUNDED_RECTANGLE );
    InsertXSec( fus, 6, XS_ROUNDED_RECTANGLE );
    Update();
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 0, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_0", 0.01964 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_0", 0.01473 );
    SetParmVal( fus, "XLocPercent", "XSec_0", 0.00000 );
    SetParmVal( fus, "ZLocPercent", "XSec_0", 0.00000 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 1, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_1", 0.32732 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_1", 0.24549 );
    SetParmVal( fus, "XLocPercent", "XSec_1", 0.00714 );
    SetParmVal( fus, "ZLocPercent", "XSec_1", 0.00000 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 2, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_2", 1.06378 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_2", 1.03104 );
    SetParmVal( fus, "XLocPercent", "XSec_2", 0.10643 );
    SetParmVal( fus, "ZLocPercent", "XSec_2", 0.02227 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 3, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_3", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_3", 1.28193 );
    SetParmVal( fus, "XLocPercent", "XSec_3", 0.15783 );
    SetParmVal( fus, "ZLocPercent", "XSec_3", 0.03693 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 4, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_4", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_4", 1.90180 );
    SetParmVal( fus, "XLocPercent", "XSec_4", 0.29434 );
    SetParmVal( fus, "ZLocPercent", "XSec_4", 0.07383 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 5, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_5", 1.12433 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_5", 1.82847 );
    SetParmVal( fus, "XLocPercent", "XSec_5", 0.47501 );
    SetParmVal( fus, "ZLocPercent", "XSec_5", 0.06970 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 6, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_6", 0.74166 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_6", 1.12596 );
    SetParmVal( fus, "XLocPercent", "XSec_6", 0.66776 );
    SetParmVal( fus, "ZLocPercent", "XSec_6", 0.05062 );
    ChangeXSecShape( GetXSecSurf( fus, 0 ), 7, XS_ROUNDED_RECTANGLE );
    SetParmVal( fus, "RoundedRect_Width",  "XSecCurve_7", 0.11883 );
    SetParmVal( fus, "RoundedRect_Height", "XSecCurve_7", 0.51503 );
    SetParmVal( fus, "XLocPercent", "XSec_7", 1.00000 );
    SetParmVal( fus, "ZLocPercent", "XSec_7", 0.05027 );
    Update();

    // ---------------- WING ----------------
    // TOP LEVEL, a sibling of the fuselage — what RAVEN's ParentID says,
    // and it is why absolute stations are correct here.
    string wing = AddGeom( "WING", "" );
    SetGeomName( wing, "Wing" );
    SetParmVal( wing, "TotalSpan", "WingGeom", wingSpan );
    SetParmVal( wing, "TotalArea", "WingGeom", wingArea );
    SetParmVal( wing, "Sweep", "XSec_1", wingSweep );
    SetParmVal( wing, "Taper", "XSec_1", 0.45005 );
    SetParmVal( wing, "X_Rel_Location", "XForm", 1.89282 );
    SetParmVal( wing, "Z_Rel_Location", "XForm", 1.49064 );
    Update();
    // 3 control surfaces, split around this layout's booms
    string ss_w0 = AddSubSurf( wing, SS_CONTROL, 0 );
    SetParmVal( wing, "EtaStart", "SS_Control_1", 0.10580 );
    SetParmVal( wing, "EtaEnd",   "SS_Control_1", 0.38600 );
    SetParmVal( wing, "Length_C_Start", "SS_Control_1", 0.23980 );
    string ss_w1 = AddSubSurf( wing, SS_CONTROL, 0 );
    SetParmVal( wing, "EtaStart", "SS_Control_2", 0.47300 );
    SetParmVal( wing, "EtaEnd",   "SS_Control_2", 0.69630 );
    SetParmVal( wing, "Length_C_Start", "SS_Control_2", 0.23980 );
    string ss_w2 = AddSubSurf( wing, SS_CONTROL, 0 );
    SetParmVal( wing, "EtaStart", "SS_Control_3", 0.70030 );
    SetParmVal( wing, "EtaEnd",   "SS_Control_3", 1.00000 );
    SetParmVal( wing, "Length_C_Start", "SS_Control_3", 0.45000 );
    Update();

    // ---------------- TAIL ----------------
    // V-tail: ONE geom mirrored, its rudder an SS_CONTROL sub-surface
    string vt = AddGeom( "WING", "" );
    SetGeomName( vt, "V-Tail" );
    SetParmVal( vt, "TotalSpan", "WingGeom", 2.79600 );
    SetParmVal( vt, "X_Rel_Location", "XForm", 6.03450 );
    SetParmVal( vt, "Z_Rel_Location", "XForm", 0.58625 );
    SetParmVal( vt, "Dihedral", "XSec_1", 38.000 );
    SetParmVal( vt, "Sweep", "XSec_1", 34.440 );
    SetParmVal( vt, "Sym_Planar_Flag", "Sym", SYM_XZ );
    string ss_rud = AddSubSurf( vt, SS_CONTROL, 0 );
    SetParmVal( vt, "EtaStart", "SS_Control_1", 0.03430 );
    SetParmVal( vt, "EtaEnd",   "SS_Control_1", 1.00000 );
    SetParmVal( vt, "Length_C_Start", "SS_Control_1", 0.21570 );
    Update();

    // ---------------- ROTOR INSTALLATIONS ----------------
    // Per RAVEN: a TILTING rotor gets Hinge -> Nacelle -> Prop, and a
    // FIXED one gets no hinge and no nacelle at all — only the stack.
    // Hub, Spacer and Motor are children of the Prop in RAVEN's tree.
    bool hingeOK = true;

    // --- Tilt 1 (tilting) ---
    string h_r0 = AddGeom( "HINGE", fus );
    if ( h_r0.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r0, "Hinge - Tilt 1" );
        SetParmVal( h_r0, "X_Rel_Location", "XForm", 3.04093 );
        SetParmVal( h_r0, "Y_Rel_Location", "XForm", -5.45383 );
        SetParmVal( h_r0, "Z_Rel_Location", "XForm", 1.49064 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r0, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r0, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r0, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r0, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r0, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r0, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r0 = AddGeom( "STACK", ( h_r0.length() > 0 ? h_r0 : fus ) );
    SetGeomName( nac_r0, "Tilt 1 Nacelle" );
    SetParmVal( nac_r0, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r0, "X_Rel_Location", "XForm", -1.06073 );
    SetParmVal( nac_r0, "Z_Rel_Location", "XForm", 0.18054 );
    Update();
    string prop_r0 = AddGeom( "PROP", ( h_r0.length() > 0 ? h_r0 : fus ) );
    SetGeomName( prop_r0, "Tilt 1" );
    SetParmVal( prop_r0, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r0, "Diameter", "Design", propDiam );
    SetParmVal( prop_r0, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r0, "X_Rel_Location", "XForm", -2.12145 );
    SetParmVal( prop_r0, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r0, "Z_Rel_Location", "XForm", 0.36108 );
    SetParmVal( prop_r0, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( hub_r0, "Hub" );
    SetParmVal( hub_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( spacer_r0, "Spacer" );
    SetParmVal( spacer_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r0 = AddGeom( "STACK", prop_r0 );
    SetGeomName( motor_r0, "Motor" );
    SetParmVal( motor_r0, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Tilt 2 (tilting) ---
    string h_r1 = AddGeom( "HINGE", fus );
    if ( h_r1.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r1, "Hinge - Tilt 2" );
        SetParmVal( h_r1, "X_Rel_Location", "XForm", 2.55046 );
        SetParmVal( h_r1, "Y_Rel_Location", "XForm", -1.81794 );
        SetParmVal( h_r1, "Z_Rel_Location", "XForm", 1.49064 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r1, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r1, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r1, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r1, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r1, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r1, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r1 = AddGeom( "STACK", ( h_r1.length() > 0 ? h_r1 : fus ) );
    SetGeomName( nac_r1, "Tilt 2 Nacelle" );
    SetParmVal( nac_r1, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r1, "X_Rel_Location", "XForm", -0.81549 );
    SetParmVal( nac_r1, "Z_Rel_Location", "XForm", 0.18751 );
    Update();
    string prop_r1 = AddGeom( "PROP", ( h_r1.length() > 0 ? h_r1 : fus ) );
    SetGeomName( prop_r1, "Tilt 2" );
    SetParmVal( prop_r1, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r1, "Diameter", "Design", propDiam );
    SetParmVal( prop_r1, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r1, "X_Rel_Location", "XForm", -1.63098 );
    SetParmVal( prop_r1, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r1, "Z_Rel_Location", "XForm", 0.37501 );
    SetParmVal( prop_r1, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( hub_r1, "Hub" );
    SetParmVal( hub_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( spacer_r1, "Spacer" );
    SetParmVal( spacer_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r1 = AddGeom( "STACK", prop_r1 );
    SetGeomName( motor_r1, "Motor" );
    SetParmVal( motor_r1, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Tilt 3 (tilting) ---
    string h_r2 = AddGeom( "HINGE", fus );
    if ( h_r2.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r2, "Hinge - Tilt 3" );
        SetParmVal( h_r2, "X_Rel_Location", "XForm", 2.55046 );
        SetParmVal( h_r2, "Y_Rel_Location", "XForm", 1.81794 );
        SetParmVal( h_r2, "Z_Rel_Location", "XForm", 1.49064 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r2, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r2, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r2, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r2, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r2, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r2, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r2 = AddGeom( "STACK", ( h_r2.length() > 0 ? h_r2 : fus ) );
    SetGeomName( nac_r2, "Tilt 3 Nacelle" );
    SetParmVal( nac_r2, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r2, "X_Rel_Location", "XForm", -0.81549 );
    SetParmVal( nac_r2, "Z_Rel_Location", "XForm", 0.18751 );
    Update();
    string prop_r2 = AddGeom( "PROP", ( h_r2.length() > 0 ? h_r2 : fus ) );
    SetGeomName( prop_r2, "Tilt 3" );
    SetParmVal( prop_r2, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r2, "Diameter", "Design", propDiam );
    SetParmVal( prop_r2, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r2, "X_Rel_Location", "XForm", -1.63098 );
    SetParmVal( prop_r2, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r2, "Z_Rel_Location", "XForm", 0.37501 );
    SetParmVal( prop_r2, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( hub_r2, "Hub" );
    SetParmVal( hub_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( spacer_r2, "Spacer" );
    SetParmVal( spacer_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r2 = AddGeom( "STACK", prop_r2 );
    SetGeomName( motor_r2, "Motor" );
    SetParmVal( motor_r2, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Tilt 4 (tilting) ---
    string h_r3 = AddGeom( "HINGE", fus );
    if ( h_r3.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r3, "Hinge - Tilt 4" );
        SetParmVal( h_r3, "X_Rel_Location", "XForm", 3.04093 );
        SetParmVal( h_r3, "Y_Rel_Location", "XForm", 5.45383 );
        SetParmVal( h_r3, "Z_Rel_Location", "XForm", 1.49064 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r3, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r3, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r3, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r3, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r3, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r3, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r3 = AddGeom( "STACK", ( h_r3.length() > 0 ? h_r3 : fus ) );
    SetGeomName( nac_r3, "Tilt 4 Nacelle" );
    SetParmVal( nac_r3, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r3, "X_Rel_Location", "XForm", -1.06073 );
    SetParmVal( nac_r3, "Z_Rel_Location", "XForm", 0.18054 );
    Update();
    string prop_r3 = AddGeom( "PROP", ( h_r3.length() > 0 ? h_r3 : fus ) );
    SetGeomName( prop_r3, "Tilt 4" );
    SetParmVal( prop_r3, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r3, "Diameter", "Design", propDiam );
    SetParmVal( prop_r3, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r3, "X_Rel_Location", "XForm", -2.12145 );
    SetParmVal( prop_r3, "Y_Rel_Location", "XForm", 0.00000 );
    SetParmVal( prop_r3, "Z_Rel_Location", "XForm", 0.36108 );
    SetParmVal( prop_r3, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( hub_r3, "Hub" );
    SetParmVal( hub_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( spacer_r3, "Spacer" );
    SetParmVal( spacer_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r3 = AddGeom( "STACK", prop_r3 );
    SetGeomName( motor_r3, "Motor" );
    SetParmVal( motor_r3, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Tail rotor L (tilting) ---
    string h_r4 = AddGeom( "HINGE", fus );
    if ( h_r4.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r4, "Hinge - Tail rotor L" );
        SetParmVal( h_r4, "X_Rel_Location", "XForm", 6.91340 );
        SetParmVal( h_r4, "Y_Rel_Location", "XForm", -1.78377 );
        SetParmVal( h_r4, "Z_Rel_Location", "XForm", 2.10108 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r4, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r4, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r4, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r4, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r4, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r4, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r4 = AddGeom( "STACK", ( h_r4.length() > 0 ? h_r4 : fus ) );
    SetGeomName( nac_r4, "Tail rotor L Nacelle" );
    SetParmVal( nac_r4, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r4, "X_Rel_Location", "XForm", -0.19975 );
    SetParmVal( nac_r4, "Z_Rel_Location", "XForm", 0.33125 );
    Update();
    string prop_r4 = AddGeom( "PROP", ( h_r4.length() > 0 ? h_r4 : fus ) );
    SetGeomName( prop_r4, "Tail rotor L" );
    SetParmVal( prop_r4, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r4, "Diameter", "Design", propDiam );
    SetParmVal( prop_r4, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r4, "X_Rel_Location", "XForm", -0.39950 );
    SetParmVal( prop_r4, "Y_Rel_Location", "XForm", -0.15511 );
    SetParmVal( prop_r4, "Z_Rel_Location", "XForm", 0.66250 );
    SetParmVal( prop_r4, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r4 = AddGeom( "STACK", prop_r4 );
    SetGeomName( hub_r4, "Hub" );
    SetParmVal( hub_r4, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r4 = AddGeom( "STACK", prop_r4 );
    SetGeomName( spacer_r4, "Spacer" );
    SetParmVal( spacer_r4, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r4 = AddGeom( "STACK", prop_r4 );
    SetGeomName( motor_r4, "Motor" );
    SetParmVal( motor_r4, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // --- Tail rotor R (tilting) ---
    string h_r5 = AddGeom( "HINGE", fus );
    if ( h_r5.length() == 0 ) { hingeOK = false; }
    else {
        SetGeomName( h_r5, "Hinge - Tail rotor R" );
        SetParmVal( h_r5, "X_Rel_Location", "XForm", 6.91340 );
        SetParmVal( h_r5, "Y_Rel_Location", "XForm", 1.78377 );
        SetParmVal( h_r5, "Z_Rel_Location", "XForm", 2.10108 );
        // lateral axis, RAVEN's own hinge orientation
        SetParmVal( h_r5, "PrimXVec", "Hinge", 0 );
        SetParmVal( h_r5, "PrimYVec", "Hinge", 1 );
        SetParmVal( h_r5, "PrimZVec", "Hinge", 0 );
        SetParmVal( h_r5, "JointRotMin", "Hinge", 0 );
        SetParmVal( h_r5, "JointRotMax", "Hinge", 110 );
        SetParmVal( h_r5, "JointRotate", "Hinge", tiltDeg );
    }
    string nac_r5 = AddGeom( "STACK", ( h_r5.length() > 0 ? h_r5 : fus ) );
    SetGeomName( nac_r5, "Tail rotor R Nacelle" );
    SetParmVal( nac_r5, "Y_Rel_Rotation", "XForm", 90 );  // vertical in hover, as RAVEN's is
    // offsets below are relative to the HINGE, this geom's parent
    SetParmVal( nac_r5, "X_Rel_Location", "XForm", -0.19975 );
    SetParmVal( nac_r5, "Z_Rel_Location", "XForm", 0.33125 );
    Update();
    string prop_r5 = AddGeom( "PROP", ( h_r5.length() > 0 ? h_r5 : fus ) );
    SetGeomName( prop_r5, "Tail rotor R" );
    SetParmVal( prop_r5, "PropMode", "Design", PROP_BLADES );
    SetParmVal( prop_r5, "Diameter", "Design", propDiam );
    SetParmVal( prop_r5, "NumBlade", "Design", nBlade );
    SetParmVal( prop_r5, "X_Rel_Location", "XForm", -0.39950 );
    SetParmVal( prop_r5, "Y_Rel_Location", "XForm", 0.15511 );
    SetParmVal( prop_r5, "Z_Rel_Location", "XForm", 0.66250 );
    SetParmVal( prop_r5, "Y_Rel_Rotation", "XForm", 90 );
    Update();
    string hub_r5 = AddGeom( "STACK", prop_r5 );
    SetGeomName( hub_r5, "Hub" );
    SetParmVal( hub_r5, "Y_Rel_Rotation", "XForm", 90 );
    // Hub diameter 0.4302 m = 0.137 D  [SRC] RAVEN
    string spacer_r5 = AddGeom( "STACK", prop_r5 );
    SetGeomName( spacer_r5, "Spacer" );
    SetParmVal( spacer_r5, "Y_Rel_Rotation", "XForm", 90 );
    // Spacer diameter 0.2543 m = 0.081 D  [SRC] RAVEN
    string motor_r5 = AddGeom( "STACK", prop_r5 );
    SetGeomName( motor_r5, "Motor" );
    SetParmVal( motor_r5, "Y_Rel_Rotation", "XForm", 90 );
    // Motor diameter 0.3799 m = 0.121 D  [SRC] RAVEN
    // hub stands 0.277 D above the member carrying it  [SRC] RAVEN
    Update();

    // ---------------- LANDING GEAR ----------------
    // Stations from RAVEN SWFT; every SIZE is this tool's own CS-27
    // drop-test result, so the gear changes with the aircraft.
    // nose 0.0824 fL, main 0.4409 fL,
    // track/span 0.1903, tyre 0.495 m
    string ngear = AddGeom( "STACK", fus );
    SetGeomName( ngear, "Nose Gear" );
    SetParmVal( ngear, "X_Rel_Location", "XForm", 0.60243 );
    SetParmVal( ngear, "Z_Rel_Location", "XForm", -1.01238 );
    string mgear = AddGeom( "STACK", fus );
    SetGeomName( mgear, "Main Gear" );
    SetParmVal( mgear, "X_Rel_Location", "XForm", 3.22306 );
    SetParmVal( mgear, "Y_Rel_Location", "XForm", 1.28072 );
    SetParmVal( mgear, "Z_Rel_Location", "XForm", -0.93300 );
    SetParmVal( mgear, "Sym_Planar_Flag", "Sym", SYM_XZ );
    Update();

    // ---------------- REPORT AND WRITE ----------------
    if ( !hingeOK )
    {
        Print( string("NOTE: AddGeom(\"HINGE\") returned nothing on this build.\n") );
        Print( string("      The model is complete but its rotors cannot be tilted.\n") );
        Print( string("      Add a Hinge by hand and re-parent the nacelles to it.\n") );
    }
    else
    {
        Print( string("Hinges built. Drag JointRotate 0..110 to convert.\n") );
    }
    Update();
    WriteVSPFile( "tiltrotor.vsp3" );
    Print( string("Wrote model.\n") );
}
